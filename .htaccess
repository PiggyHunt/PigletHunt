<IfModule mod_php7.c>
    php_value auto_prepend_file "C:/UwAmp/www/_bootstrap.php"
</IfModule>

RewriteEngine On

# removes .php extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.php$
RewriteRule ^(.+)$ $1.php [L]

ErrorDocument 404 /log.php